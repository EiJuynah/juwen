# DeepSeek API Key —— 仅服务端读取，不会下发到浏览器
DEEPSEEK_API_KEY=sk-your-key-here

# 模型与端点。deepseek-flash 即 V4.1-Flash 的官方 API 名
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 推理强度：low 压制思考长度，避免挤占答案配额
DEEPSEEK_EFFORT=low

# 解读档位（两档）：
#   explain（默认）= 讲透：术语当场讲清、可补背景，补充内容必须标注为补充
#   strict        = 严格依据：只用原文作答、逐条标出依据段落，不联网
# 旧变量 DEEPSEEK_CONSTRAINTS 仍兼容一个版本：=1 → strict，其余 → explain（之后移除）
DEEPSEEK_PROFILE=explain

# ── 联网检索 ──────────────────────────────────────────────────────────
# 风险提示：开启后，**选中的文字会被作为检索词发往第三方搜索服务**。
# 内部文件请勿开启。默认关闭，需在设置面板里显式打开。
#
# 检索服务商：
#   none      默认，不联网
#   deepseek  ★推荐：用**下面同一把 DEEPSEEK_API_KEY** 调 DeepSeek 原生服务端搜索
#             （Anthropic 兼容 Messages API + 服务端工具 web_search_20250305），
#             不需要再购买第三方搜索服务；结果同样是结构化的来源列表。
#   bocha     博查搜索 API（需另配 BOCHA_API_KEY）
#   mock      离线假数据，仅用于本地演示与测试（混入非权威源以验证白名单确实在过滤）
SEARCH_PROVIDER=none

# DeepSeek 原生搜索（SEARCH_PROVIDER=deepseek 时使用）。
# 只需上面已有的 DEEPSEEK_API_KEY。默认端点与模型如下，一般不用改：
# DEEPSEEK_SEARCH_BASE_URL=https://api.deepseek.com/anthropic/v1
# DEEPSEEK_SEARCH_MODEL=deepseek-v4-flash

# 博查 API Key（https://open.bocha.cn 注册获取，按次计费，新账号有免费额度）
# BOCHA_API_KEY=sk-your-bocha-key
# BOCHA_BASE_URL=https://api.bocha.cn

# 联网功能的总开关。1=启动即开启；不设置=默认关闭，由用户在设置面板里打开
# SEARCH_ENABLED=1

# 检索结果必须命中的域名白名单（逗号分隔）。
# 不设置=使用内置权威源列表（gov.cn / npc.gov.cn / cppcc.gov.cn / news.cn /
#   xinhuanet.com / people.com.cn / qstheory.cn / gmw.cn / cctv.com /
#   chinanews.com.cn / china.com.cn / legaldaily.com.cn）
# 设为 * = 关闭过滤，放行全网（内部使用请勿这样设）
# SEARCH_ALLOWED_DOMAINS=

# 桥接层端口
PORT=5178

# 额外放行的 Origin，逗号分隔。本机开发（localhost 不同端口）已默认放行，
# 只有从别的域名访问时才需要显式添加
# ALLOWED_ORIGINS=https://your-domain.com
